# Adoption Tracker API Configuration
# Copy this file to .env.local and fill in your values
# .env.local is git-ignored and not committed

# API Base URL (e.g., https://vpce-xxxx.execute-api.us-east-1.vpce.amazonaws.com/develop)
VITE_API_BASE_URL=

# API Gateway ID (x-apigw-api-id header)
VITE_API_ID=

# API Key (x-api-key header) - KEEP THIS SECRET, only in .env.local
VITE_API_KEY=

# Agent ID (x-agent-id header, default: clarvo-rag-v1)
VITE_AGENT_ID=clarvo-rag-v1

# Query window in days (default: 30)
VITE_WINDOW_DAYS=30
